<Window
    x:Class="PINGGO.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:PINGGO.Views"
    Title="PINGGO - Multi-Space App">

    <Grid Background="{StaticResource AppBackgroundBrush}">
        <!-- Main Application Shell -->
        <Grid>
            <Grid.RowDefinitions>
                <!-- Compact global header -->
                <RowDefinition Height="56" />
                <RowDefinition Height="1" />
                <!-- Main Workspace Area -->
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Global Header -->
            <views:GlobalHeaderControl Grid.Row="0" />
            <Border Grid.Row="1" Background="{StaticResource AppBorderBrush}" />

            <!-- Sidebar + Active Workspace -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="208" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Sidebar -->
                <views:SidebarControl Grid.Column="0" />

                <!-- Dynamic Workspace Content Host -->
                <Grid Grid.Column="1">
                    <views:HomeControl x:Name="HomeViewHost" Visibility="Visible" />
                    <views:PortalViewControl x:Name="PortalViewHost" Visibility="Collapsed" />
                    <views:SplitPortalControl x:Name="SplitPortalHost" Visibility="Collapsed" />
                    <views:BrowserViewControl x:Name="BrowserViewHost" Visibility="Collapsed" />
                    <views:SettingsControl x:Name="SettingsViewHost" Visibility="Collapsed" />
                </Grid>
            </Grid>
        </Grid>

        <!-- Command Palette Modal Overlay (Ctrl+K) -->
        <views:CommandPaletteControl x:Name="CommandPaletteOverlay" Visibility="Collapsed" />

        <!-- App Lock Screen Overlay -->
        <views:LockScreenControl x:Name="LockScreenOverlay" Visibility="Collapsed" />

        <!-- Toast Notification Pill Overlay -->
        <Border x:Name="ToastContainer" Visibility="Collapsed"
                HorizontalAlignment="Center" VerticalAlignment="Bottom"
                Margin="0,0,0,20" Background="#F012151A" BorderBrush="{StaticResource AppBorderBrush}"
                BorderThickness="1" CornerRadius="8" Padding="14,9">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <FontIcon Glyph="&#xE73E;" FontSize="13" Foreground="{StaticResource AppSuccessBrush}" />
                <TextBlock x:Name="ToastText" Text="Notification" FontSize="13" FontWeight="Medium" Foreground="White" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
