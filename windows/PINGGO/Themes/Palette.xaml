<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:PINGGO.Converters">

    <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter" />

    <!-- Minimal, low-chroma application palette -->
    <Color x:Key="AppBackgroundColor">#0C0E12</Color>
    <Color x:Key="AppPanelColor">#12151A</Color>
    <Color x:Key="AppSidebarColor">#0F1217</Color>
    <Color x:Key="AppCardColor">#171B21</Color>
    <Color x:Key="AppHoverColor">#1C2129</Color>
    <Color x:Key="AppBorderColor">#252B34</Color>
    <Color x:Key="AppAccentColor">#7C5CFC</Color>
    <Color x:Key="AppSelectedColor">#267C5CFC</Color>
    <Color x:Key="AppTextColor">#EEF0F4</Color>
    <Color x:Key="AppSuccessColor">#22C55E</Color>
    <Color x:Key="AppWarningColor">#F59E0B</Color>
    <Color x:Key="AppErrorColor">#EF4444</Color>
    <Color x:Key="AppTextMutedColor">#9299A6</Color>

    <SolidColorBrush x:Key="AppBackgroundBrush" Color="{StaticResource AppBackgroundColor}" />
    <SolidColorBrush x:Key="AppPanelBrush" Color="{StaticResource AppPanelColor}" />
    <SolidColorBrush x:Key="AppSidebarBrush" Color="{StaticResource AppSidebarColor}" />
    <SolidColorBrush x:Key="AppCardBrush" Color="{StaticResource AppCardColor}" />
    <SolidColorBrush x:Key="AppHoverBrush" Color="{StaticResource AppHoverColor}" />
    <SolidColorBrush x:Key="AppBorderBrush" Color="{StaticResource AppBorderColor}" />
    <SolidColorBrush x:Key="AppAccentBrush" Color="{StaticResource AppAccentColor}" />
    <SolidColorBrush x:Key="AppSelectedBrush" Color="{StaticResource AppSelectedColor}" />
    <SolidColorBrush x:Key="AppTextBrush" Color="{StaticResource AppTextColor}" />
    <SolidColorBrush x:Key="AppSuccessBrush" Color="{StaticResource AppSuccessColor}" />
    <SolidColorBrush x:Key="AppTextMutedBrush" Color="{StaticResource AppTextMutedColor}" />

    <!-- Control Styles -->
    <Style x:Key="PillNavButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource AppTextMutedBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="12,5" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <Style x:Key="IconButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource AppTextMutedBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource AppBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <Style x:Key="MinimalCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource AppPanelBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource AppBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="16" />
    </Style>
</ResourceDictionary>
