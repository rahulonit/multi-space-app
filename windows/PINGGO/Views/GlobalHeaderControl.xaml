<UserControl
    x:Class="PINGGO.Views.GlobalHeaderControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:PINGGO.ViewModels">

    <Grid x:Name="HeaderRoot" Height="64" Background="{StaticResource AppPanelBrush}" Padding="20,0,24,0" SizeChanged="OnHeaderSizeChanged">
        <Grid.ColumnDefinitions>
            <!-- Brand area: 220-260px -->
            <ColumnDefinition x:Name="BrandColumn" Width="230" />
            <!-- Centered Navigation Pill -->
            <ColumnDefinition Width="Auto" />
            <!-- Flexible Spacer -->
            <ColumnDefinition Width="*" />
            <!-- Right Controls -->
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- Brand Area -->
        <Button Grid.Column="0" Click="OnBrandClicked" Background="Transparent" BorderThickness="0" Padding="4">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Border Width="34" Height="34" CornerRadius="10" Background="{StaticResource AppAccentBrush}">
                    <FontIcon Glyph="&#xE774;" FontSize="18" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock x:Name="BrandNameText" Text="Pinggo" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="White" TextWrapping="NoWrap" />
            </StackPanel>
        </Button>

        <!-- Primary Navigation Segmented Pill -->
        <Border Grid.Column="1" Background="{StaticResource AppCardBrush}" CornerRadius="20" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" Height="40" Padding="4" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="4">
                <Button x:Name="PlatformTabBtn" Click="OnPlatformTabClicked" Style="{StaticResource PillNavButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE81E;" FontSize="12" />
                        <TextBlock Text="Platform" TextWrapping="NoWrap" MaxLines="1" />
                    </StackPanel>
                </Button>

                <Button x:Name="OverviewTabBtn" Click="OnOverviewTabClicked" Style="{StaticResource PillNavButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE80F;" FontSize="12" />
                        <TextBlock Text="Overview" TextWrapping="NoWrap" MaxLines="1" />
                    </StackPanel>
                </Button>

                <Button x:Name="InboxTabBtn" Click="OnInboxTabClicked" Style="{StaticResource PillNavButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE8BD;" FontSize="12" />
                        <TextBlock Text="Inbox" TextWrapping="NoWrap" MaxLines="1" />
                        <Border x:Name="InboxBadge" Background="{StaticResource AppErrorColor}" CornerRadius="10" Padding="6,1" Visibility="Collapsed">
                            <TextBlock x:Name="InboxBadgeText" FontSize="10" FontWeight="Bold" Foreground="White" TextWrapping="NoWrap" MaxLines="1" />
                        </Border>
                    </StackPanel>
                </Button>

                <Button x:Name="BrowserTabBtn" Click="OnBrowserTabClicked" Style="{StaticResource PillNavButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE774;" FontSize="12" />
                        <TextBlock Text="Browser" TextWrapping="NoWrap" MaxLines="1" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <!-- Right Controls -->
        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
            <!-- Security Pill (80-100px) -->
            <Border x:Name="SecurityPill" Background="#1A22C55E" BorderBrush="#4D22C55E" BorderThickness="1" CornerRadius="14" Padding="10,4">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE72E;" FontSize="11" Foreground="{StaticResource AppSuccessBrush}" />
                    <TextBlock Text="SECURE" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AppSuccessBrush}" />
                </StackPanel>
            </Border>

            <!-- Search (220-280px) -->
            <TextBox x:Name="SearchBox" Width="240" Height="36" PlaceholderText="Search messages (Ctrl+K)..."
                     Background="{StaticResource AppCardBrush}" BorderBrush="{StaticResource AppBorderBrush}"
                     CornerRadius="8" KeyDown="OnSearchKeyDown" />

            <!-- Notifications Button -->
            <Button Style="{StaticResource IconButtonStyle}" Click="OnNotificationClicked" ToolTipService.ToolTip="Notifications">
                <FontIcon Glyph="&#xEA8F;" FontSize="14" />
            </Button>

            <!-- Profile Avatar Button -->
            <Button Style="{StaticResource IconButtonStyle}" Click="OnProfileClicked" ToolTipService.ToolTip="User Profile &amp; Settings">
                <FontIcon Glyph="&#xE77B;" FontSize="14" />
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
