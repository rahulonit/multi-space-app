<UserControl
    x:Class="PINGGO.Views.GlobalHeaderControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:PINGGO.ViewModels">

    <Grid x:Name="HeaderRoot" Height="56" Background="{StaticResource AppPanelBrush}" Padding="16,0" SizeChanged="OnHeaderSizeChanged">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="BrandColumn" Width="192" />
            <!-- Centered Navigation Pill -->
            <ColumnDefinition Width="Auto" />
            <!-- Flexible Spacer -->
            <ColumnDefinition Width="*" />
            <!-- Right Controls -->
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- Brand Area -->
        <Button Grid.Column="0" Click="OnBrandClicked" Background="Transparent" BorderThickness="0" Padding="2">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Border Width="28" Height="28" CornerRadius="7" Background="{StaticResource AppAccentBrush}">
                    <FontIcon Glyph="&#xE774;" FontSize="15" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock x:Name="BrandNameText" Text="Pinggo" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{StaticResource AppTextBrush}" TextWrapping="NoWrap" />
            </StackPanel>
        </Button>

        <!-- Quiet segmented navigation -->
        <Border Grid.Column="1" Background="{StaticResource AppSidebarBrush}" CornerRadius="8" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" Height="36" Padding="3" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="2">
                <Button x:Name="PlatformTabBtn" Click="OnPlatformTabClicked" Style="{StaticResource PillNavButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE81E;" FontSize="12" />
                        <TextBlock Text="Platform" TextWrapping="NoWrap" MaxLines="1" />
                    </StackPanel>
                </Button>

                <Button x:Name="OverviewTabBtn" Click="OnOverviewTabClicked" Style="{StaticResource PillNavButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE80F;" FontSize="12" />
                        <TextBlock Text="Overview" TextWrapping="NoWrap" MaxLines="1" />
                    </StackPanel>
                </Button>

                <Button x:Name="BrowserTabBtn" Click="OnBrowserTabClicked" Style="{StaticResource PillNavButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE774;" FontSize="12" />
                        <TextBlock Text="Browser" TextWrapping="NoWrap" MaxLines="1" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <!-- Right Controls -->
        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <Border x:Name="SecurityPill" Background="#1022C55E" BorderBrush="#3022C55E" BorderThickness="1" CornerRadius="6" Padding="8,4">
                <StackPanel Orientation="Horizontal" Spacing="5">
                    <FontIcon Glyph="&#xE72E;" FontSize="11" Foreground="{StaticResource AppSuccessBrush}" />
                    <TextBlock Text="Secure" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource AppSuccessBrush}" />
                </StackPanel>
            </Border>

            <!-- Search (220-280px) -->
            <TextBox x:Name="SearchBox" Width="220" Height="32" PlaceholderText="Search · Ctrl+K"
                     Background="{StaticResource AppSidebarBrush}" BorderBrush="{StaticResource AppBorderBrush}"
                     CornerRadius="6" KeyDown="OnSearchKeyDown" />

            <!-- Notifications Button -->
            <Button Style="{StaticResource IconButtonStyle}" Click="OnNotificationClicked" ToolTipService.ToolTip="Notifications">
                <FontIcon Glyph="&#xEA8F;" FontSize="14" />
            </Button>

            <!-- Profile Avatar Button -->
            <Button Style="{StaticResource IconButtonStyle}" Click="OnProfileClicked" ToolTipService.ToolTip="User Profile &amp; Settings">
                <FontIcon Glyph="&#xE77B;" FontSize="14" />
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
