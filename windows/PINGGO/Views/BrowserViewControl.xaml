<UserControl
    x:Class="PINGGO.Views.BrowserViewControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:PINGGO.Models">

    <Grid Background="{StaticResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <!-- Tab Bar (36px) -->
            <RowDefinition Height="36" />
            <RowDefinition Height="1" />
            <!-- Toolbar & Omnibar (52px) -->
            <RowDefinition Height="52" />
            <RowDefinition Height="1" />
            <!-- Browser Content -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 1. Multi-Tab Bar (36px) -->
        <Grid Grid.Row="0" Background="{StaticResource AppSidebarBrush}" Padding="8,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <ItemsRepeater x:Name="TabsRepeater" ItemsSource="{x:Bind ViewModel.Tabs}">
                    <ItemsRepeater.Layout>
                        <StackLayout Orientation="Horizontal" Spacing="6" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="models:BrowserTabItem">
                            <Button Click="OnTabSelected" Tag="{x:Bind Id}" Background="{StaticResource AppCardBrush}" CornerRadius="8" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" Padding="8,4">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Image Source="{x:Bind FaviconUrl}" Width="14" Height="14" />
                                    <TextBlock Text="{x:Bind Title}" FontSize="11" FontWeight="Medium" Foreground="White" MaxWidth="130" TextTrimming="CharacterEllipsis" />
                                    <Button Click="OnCloseTabClicked" Tag="{x:Bind Id}" Background="Transparent" BorderThickness="0" Padding="2" Width="18" Height="18" ToolTipService.ToolTip="Close Tab">
                                        <FontIcon Glyph="&#xE711;" FontSize="9" Foreground="{StaticResource AppTextMutedBrush}" />
                                    </Button>
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </ScrollViewer>

            <!-- New Tab Button -->
            <Button Grid.Column="1" Click="OnNewTabClicked" Style="{StaticResource IconButtonStyle}" Width="26" Height="26" ToolTipService.ToolTip="New Tab (Ctrl+T)">
                <FontIcon Glyph="&#xE710;" FontSize="11" />
            </Button>
        </Grid>

        <Border Grid.Row="1" Background="{StaticResource AppBorderBrush}" />

        <!-- 2. Browser Navigation & Omnibar (52px) -->
        <Grid Grid.Row="2" Background="{StaticResource AppPanelBrush}" Padding="16,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Navigation Controls -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <Button Click="OnGoBackClicked" Style="{StaticResource IconButtonStyle}" Width="32" Height="32" ToolTipService.ToolTip="Back">
                    <FontIcon Glyph="&#xE72B;" FontSize="12" />
                </Button>
                <Button Click="OnGoForwardClicked" Style="{StaticResource IconButtonStyle}" Width="32" Height="32" ToolTipService.ToolTip="Forward">
                    <FontIcon Glyph="&#xE72A;" FontSize="12" />
                </Button>
                <Button Click="OnReloadClicked" Style="{StaticResource IconButtonStyle}" Width="32" Height="32" ToolTipService.ToolTip="Reload">
                    <FontIcon Glyph="&#xE72C;" FontSize="12" />
                </Button>
                <Button Click="OnHomeClicked" Style="{StaticResource IconButtonStyle}" Width="32" Height="32" ToolTipService.ToolTip="Browser Home">
                    <FontIcon Glyph="&#xE80F;" FontSize="12" />
                </Button>
            </StackPanel>

            <!-- Smart Omnibar (Centered) -->
            <Grid Grid.Column="1" Margin="14,0" Height="36" VerticalAlignment="Center">
                <Border Background="{StaticResource AppBackgroundBrush}" CornerRadius="8" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" />
                <TextBox x:Name="OmnibarBox" PlaceholderText="Search with DuckDuckGo or enter URL…"
                         Background="Transparent" BorderThickness="0" Padding="12,7" FontSize="13" Foreground="White"
                         KeyDown="OnOmnibarKeyDown" VerticalAlignment="Center" />

                <!-- Star Bookmark & Reader Mode icons on right inside Omnibar -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="4" Margin="0,0,8,0" VerticalAlignment="Center">
                    <Button Click="OnReaderModeClicked" Background="Transparent" BorderThickness="0" Padding="4" ToolTipService.ToolTip="Reader Mode">
                        <FontIcon Glyph="&#xE8E9;" FontSize="12" Foreground="{StaticResource AppTextMutedBrush}" />
                    </Button>
                    <Button Click="OnBookmarkClicked" Background="Transparent" BorderThickness="0" Padding="4" ToolTipService.ToolTip="Bookmark this page">
                        <FontIcon Glyph="&#xE734;" FontSize="12" Foreground="{StaticResource AppTextMutedBrush}" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Right Controls: AdBlocker Status Pill with Whitelisting Flyout -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Background="#1A22C55E" BorderBrush="#4D22C55E" BorderThickness="1" CornerRadius="16" Padding="10,5">
                    <Button.Flyout>
                        <Flyout Placement="Bottom">
                            <StackPanel Width="280" Spacing="12">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE72E;" FontSize="18" Foreground="{StaticResource AppSuccessBrush}" />
                                    <StackPanel>
                                        <TextBlock Text="PINGGO AdBlock Shield" FontSize="13" FontWeight="Bold" Foreground="White" />
                                        <TextBlock Text="Local request &amp; cosmetic filtering" FontSize="10" Foreground="{StaticResource AppTextMutedBrush}" />
                                    </StackPanel>
                                </StackPanel>
                                <Border Background="{StaticResource AppCardBrush}" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10">
                                    <StackPanel Spacing="6">
                                        <Grid>
                                            <TextBlock Text="Current Site" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AppTextMutedBrush}" />
                                            <TextBlock x:Name="CurrentHostText" HorizontalAlignment="Right" Text="{x:Bind ViewModel.CurrentHost, Mode=OneWay}" FontSize="11" FontWeight="SemiBold" Foreground="White" />
                                        </Grid>
                                        <ToggleSwitch x:Name="WhitelistSwitch" Header="Pause AdBlock on this site" IsOn="{x:Bind ViewModel.IsCurrentDomainWhitelisted, Mode=TwoWay}" Toggled="OnWhitelistToggled" FontSize="11" />
                                    </StackPanel>
                                </Border>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="Blocked items:" FontSize="11" Foreground="{StaticResource AppTextMutedBrush}" />
                                    <TextBlock Text="{x:Bind ViewModel.BlockedAdsCount, Mode=OneWay}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AppSuccessBrush}" />
                                </StackPanel>
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE72E;" FontSize="11" Foreground="{StaticResource AppSuccessBrush}" />
                        <TextBlock Text="AdBlock" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AppSuccessBrush}" />
                        <Border Background="{StaticResource AppSuccessBrush}" CornerRadius="8" Padding="5,1">
                            <TextBlock x:Name="BlockedCountText" Text="0" FontSize="10" FontWeight="Bold" Foreground="White" />
                        </Border>
                    </StackPanel>
                </Button>

                <Button Click="OnOpenInEdgeClicked" Style="{StaticResource IconButtonStyle}" Width="32" Height="32" ToolTipService.ToolTip="Open in external browser">
                    <FontIcon Glyph="&#xE8A7;" FontSize="12" />
                </Button>
            </StackPanel>
        </Grid>

        <Border Grid.Row="3" Background="{StaticResource AppBorderBrush}" />

        <!-- 3. Web View & Start Page Canvas -->
        <Grid Grid.Row="4">
            <!-- Live Web Content -->
            <WebView2 x:Name="BrowserWebView" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />

            <!-- Start Page (Visible when no URL loaded) -->
            <ScrollViewer x:Name="StartPageScrollViewer" Background="{StaticResource AppBackgroundBrush}" VerticalScrollBarVisibility="Auto">
                <StackPanel HorizontalAlignment="Center" Spacing="28" Padding="24,40,24,60" MaxWidth="680">
                    <Border Width="64" Height="64" CornerRadius="20" Background="{StaticResource AppAccentBrush}" HorizontalAlignment="Center">
                        <FontIcon Glyph="&#xE774;" FontSize="32" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Spacing="6" HorizontalAlignment="Center">
                        <TextBlock Text="PINGGO Private Browser" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" Foreground="White" />
                        <TextBlock Text="Native WebView2 AdBlocker Active · Zero Telemetry · Profile Sandboxed" FontSize="12" HorizontalAlignment="Center" Foreground="{StaticResource AppTextMutedBrush}" />
                    </StackPanel>

                    <!-- Big Search Box -->
                    <TextBox x:Name="StartPageSearchBox" PlaceholderText="Search with DuckDuckGo or enter URL..." Height="48" CornerRadius="12" Background="{StaticResource AppCardBrush}" BorderBrush="{StaticResource AppBorderBrush}" Padding="16,12" FontSize="14" KeyDown="OnStartPageSearchKeyDown" />

                    <!-- Quick Favorites Grid -->
                    <StackPanel Spacing="14">
                        <TextBlock Text="TOP FAVORITES &amp; QUICK LAUNCH" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AppTextMutedBrush}" />
                        <GridView x:Name="FavoritesGridView" SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnFavoriteItemClicked">
                            <!-- Populated in code-behind -->
                        </GridView>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
