<UserControl
    x:Class="PINGGO.Views.CommandPaletteControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="#B3000000" Tapped="OnBackdropTapped">
        <Border Width="600" MaxHeight="500" VerticalAlignment="Top" Margin="0,88,0,0"
                Background="{ThemeResource AppElevatedBrush}" BorderBrush="{ThemeResource AppBorderBrush}"
                BorderThickness="1" CornerRadius="18" Padding="20">
            <StackPanel Spacing="16">
                <!-- Search Box -->
                <Grid Height="48">
                    <TextBox x:Name="PaletteSearchBox" PlaceholderText="Type a command or jump to workspace..."
                             Background="{ThemeResource AppCardBrush}" BorderBrush="{ThemeResource AppBorderBrush}"
                             CornerRadius="10" Padding="42,12,16,12" FontSize="14"
                             TextChanged="OnSearchTextChanged" KeyDown="OnSearchKeyDown" />
                    <FontIcon Glyph="&#xE721;" FontSize="14" Foreground="{StaticResource AppTextMutedBrush}" HorizontalAlignment="Left" Margin="12,0,0,0" VerticalAlignment="Center" />
                </Grid>

                <!-- Commands / Results List -->
                <ListView x:Name="ResultsListView" SelectionMode="Single" ItemClick="OnCommandItemClicked" IsItemClickEnabled="True" MaxHeight="320">
                    <!-- Populated dynamically -->
                </ListView>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
