<UserControl
    x:Class="PINGGO.Views.HomeControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:PINGGO.Models">

    <ScrollViewer Background="{ThemeResource AppBackgroundBrush}" Padding="40,32,40,48">
        <StackPanel Spacing="32" MaxWidth="1120" HorizontalAlignment="Left">
            <!-- Welcome Banner -->
            <StackPanel Spacing="8">
                <TextBlock Text="Overview" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="Messages, platforms, and AI in one calm workspace." FontSize="14" Foreground="{ThemeResource AppTextMutedBrush}" />
            </StackPanel>

            <!-- Metrics Cards Row -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Card 1 -->
                <Border Grid.Column="0" Style="{StaticResource MinimalCardStyle}" Margin="0,0,8,0">
                    <StackPanel Spacing="6">
                        <TextBlock Text="Connected platforms" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AppTextMutedBrush}" />
                        <TextBlock x:Name="ConnectedPlatformsText" Text="No platforms yet" FontSize="18" FontWeight="SemiBold" Foreground="{ThemeResource AppTextBrush}" />
                        <TextBlock Text="Add only the services you want to use" FontSize="12" Foreground="{ThemeResource AppTextMutedBrush}" />
                    </StackPanel>
                </Border>

                <!-- Card 2 -->
                <Border Grid.Column="1" Style="{StaticResource MinimalCardStyle}" Margin="4,0">
                    <StackPanel Spacing="6">
                        <TextBlock Text="Profile isolation" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AppTextMutedBrush}" />
                        <TextBlock Text="Protected" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource AppSuccessBrush}" />
                        <TextBlock Text="Unique Edge WebView2 user data stores" FontSize="12" Foreground="{StaticResource AppTextMutedBrush}" />
                    </StackPanel>
                </Border>

                <!-- Card 3 -->
                <Border Grid.Column="2" Style="{StaticResource MinimalCardStyle}" Margin="8,0,0,0">
                    <StackPanel Spacing="6">
                        <TextBlock Text="AI assistant" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AppTextMutedBrush}" />
                        <TextBlock Text="Ready to connect" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource AppAccentBrush}" />
                        <TextBlock Text="Connect a provider in Settings or use the local Smart Engine" FontSize="12" Foreground="{StaticResource AppTextMutedBrush}" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Quick Launch Platform Grid -->
            <StackPanel Spacing="14">
                <TextBlock Text="Active platforms" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource AppTextMutedBrush}" />
                <Border x:Name="EmptyPlatformsPanel" Style="{StaticResource MinimalCardStyle}" MaxWidth="560" HorizontalAlignment="Left">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Your workspace is empty" Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock Text="Use Add platform in the sidebar to choose your first service. PINGGO will create its isolated Personal account when you add it." FontSize="14" Foreground="{ThemeResource AppTextMutedBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
                <GridView x:Name="PlatformsGrid" ItemContainerStyle="{StaticResource CardGridViewItemStyle}" SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnPlatformCardClicked">
                    <GridView.ItemTemplate>
                        <DataTemplate x:DataType="models:SocialPlatform">
                            <Border Style="{StaticResource MinimalCardStyle}" Width="210" Height="88" Margin="0,0,10,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="40" Height="40" CornerRadius="10" Background="{StaticResource AppCardBrush}" Margin="0,0,12,0">
                                        <FontIcon Glyph="&#xE774;" FontSize="18" Foreground="{StaticResource AppAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="{x:Bind Name}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource AppTextBrush}" />
                                        <TextBlock Text="Active Session" FontSize="11" Foreground="{StaticResource AppTextMutedBrush}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
