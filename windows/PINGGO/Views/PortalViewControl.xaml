<UserControl
    x:Class="PINGGO.Views.PortalViewControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{StaticResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="1" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="{StaticResource AppPanelBrush}" Padding="16,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Border Width="28" Height="28" CornerRadius="6" Background="{StaticResource AppCardBrush}">
                    <FontIcon Glyph="&#xE774;" FontSize="13" Foreground="{StaticResource AppAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock x:Name="PlatformTitleText" Text="WhatsApp" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                <Button x:Name="AccountMenuButton" Click="OnAccountMenuClicked" Background="{StaticResource AppCardBrush}" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="9,4">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <FontIcon Glyph="&#xE77B;" FontSize="11" />
                        <TextBlock x:Name="AccountNameText" Text="Personal" FontSize="11" FontWeight="SemiBold" TextWrapping="NoWrap" />
                        <FontIcon Glyph="&#xE70D;" FontSize="9" />
                    </StackPanel>
                </Button>
                <Button Click="OnPasskeyChipClicked" Background="Transparent" BorderThickness="0" Padding="6,3" ToolTipService.ToolTip="Passkey ready">
                    <FontIcon Glyph="&#xE8D7;" FontSize="11" Foreground="{StaticResource AppWarningBrush}" />
                </Button>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <Button Click="OnGoBack" Style="{StaticResource IconButtonStyle}" Width="30" Height="30" ToolTipService.ToolTip="Back"><FontIcon Glyph="&#xE72B;" FontSize="11" /></Button>
                <Button Click="OnGoForward" Style="{StaticResource IconButtonStyle}" Width="30" Height="30" ToolTipService.ToolTip="Forward"><FontIcon Glyph="&#xE72A;" FontSize="11" /></Button>
                <Button Click="OnReload" Style="{StaticResource IconButtonStyle}" Width="30" Height="30" ToolTipService.ToolTip="Reload"><FontIcon Glyph="&#xE72C;" FontSize="11" /></Button>
                <Button x:Name="MuteBtn" Click="OnToggleMute" Style="{StaticResource IconButtonStyle}" Width="30" Height="30" ToolTipService.ToolTip="Mute Audio"><FontIcon x:Name="MuteIcon" Glyph="&#xE767;" FontSize="12" /></Button>
                <Button x:Name="CopilotToggleBtn" Click="OnToggleCopilotDrawer" Background="{StaticResource AppCardBrush}" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="9,5" ToolTipService.ToolTip="Open Pinggo AI">
                    <StackPanel Orientation="Horizontal" Spacing="5"><FontIcon Glyph="&#xE945;" FontSize="11" Foreground="{StaticResource AppAccentBrush}" /><TextBlock Text="AI" FontSize="11" FontWeight="SemiBold" /></StackPanel>
                </Button>
                <Button Click="OnSplitViewClicked" Style="{StaticResource IconButtonStyle}" Width="30" Height="30" ToolTipService.ToolTip="Toggle Split View"><FontIcon Glyph="&#xE78A;" FontSize="12" /></Button>
                <Button Click="OnOpenInEdge" Style="{StaticResource IconButtonStyle}" Width="30" Height="30" ToolTipService.ToolTip="Open in default browser"><FontIcon Glyph="&#xE8A7;" FontSize="12" /></Button>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Background="{StaticResource AppBorderBrush}" />
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid x:Name="WebViewHost" Grid.Column="0" />

            <Border x:Name="CopilotDrawer" Grid.Column="1" Width="344" Visibility="Collapsed" Background="{StaticResource AppPanelBrush}" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="42" />
                        <RowDefinition Height="1" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="1" />
                        <RowDefinition Height="58" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Padding="12,0">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE945;" FontSize="12" Foreground="{StaticResource AppAccentBrush}" />
                            <TextBlock Text="Pinggo AI" FontSize="13" FontWeight="SemiBold" />
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <Ellipse x:Name="ProviderIndicatorDot" Width="5" Height="5" Fill="{StaticResource AppSuccessBrush}" />
                                <TextBlock x:Name="ProviderBadgeText" Text="Smart Engine" FontSize="9.5" Foreground="{StaticResource AppTextMutedBrush}" />
                            </StackPanel>
                        </StackPanel>
                        <Button Click="OnCloseCopilotDrawer" Style="{StaticResource IconButtonStyle}" Width="26" Height="26" HorizontalAlignment="Right" VerticalAlignment="Center" ToolTipService.ToolTip="Close Pinggo AI"><FontIcon Glyph="&#xE711;" FontSize="10" /></Button>
                    </Grid>
                    <Border Grid.Row="1" Background="{StaticResource AppBorderBrush}" />

                    <StackPanel Grid.Row="2" Spacing="7" Padding="12,9" Background="{StaticResource AppSidebarBrush}">
                        <Grid>
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <FontIcon Glyph="&#xE77B;" FontSize="10" Foreground="{StaticResource AppTextMutedBrush}" />
                                <TextBlock x:Name="CopilotContactName" Text="Active conversation" FontSize="11.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="190" />
                            </StackPanel>
                            <Border x:Name="UrgencyBadge" HorizontalAlignment="Right" CornerRadius="6" Padding="6,2" Background="Transparent"><TextBlock x:Name="UrgencyBadgeText" Text="Normal" FontSize="9.5" Foreground="{StaticResource AppTextMutedBrush}" /></Border>
                        </Grid>
                        <Grid>
                            <TextBlock x:Name="SentimentClassificationText" Text="Sentiment: Neutral" FontSize="9.5" Foreground="{StaticResource AppTextMutedBrush}" />
                            <TextBlock x:Name="SentimentScoreText" Text="+0.0" FontSize="9.5" HorizontalAlignment="Right" Foreground="{StaticResource AppTextMutedBrush}" />
                        </Grid>
                        <ProgressBar x:Name="SentimentGauge" Value="50" Maximum="100" Height="2" Foreground="{StaticResource AppAccentBrush}" Background="Transparent" />
                        <Border x:Name="LatestMessageSnippetContainer" Visibility="Collapsed">
                            <TextBlock x:Name="LatestMessageSnippetText" FontSize="10" Foreground="{StaticResource AppTextMutedBrush}" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                        </Border>
                    </StackPanel>

                    <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" Padding="12">
                        <StackPanel Spacing="14">
                            <StackPanel Spacing="7">
                                <TextBlock Text="Draft a reply" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource AppTextMutedBrush}" />
                                <Grid ColumnSpacing="6" RowSpacing="6">
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <Button Grid.Row="0" Grid.Column="0" Click="OnSmartToneClicked" Tag="Professional" Padding="6" CornerRadius="6" Background="{StaticResource AppCardBrush}" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1"><TextBlock Text="Professional" FontSize="10" HorizontalAlignment="Center" /></Button>
                                    <Button Grid.Row="0" Grid.Column="1" Click="OnSmartToneClicked" Tag="Friendly" Padding="6" CornerRadius="6" Background="{StaticResource AppCardBrush}" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1"><TextBlock Text="Friendly" FontSize="10" HorizontalAlignment="Center" /></Button>
                                    <Button Grid.Row="0" Grid.Column="2" Click="OnSmartToneClicked" Tag="Concise" Padding="6" CornerRadius="6" Background="{StaticResource AppCardBrush}" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1"><TextBlock Text="Concise" FontSize="10" HorizontalAlignment="Center" /></Button>
                                    <Button Grid.Row="1" Grid.Column="0" Click="OnSmartToneClicked" Tag="Casual" Padding="6" CornerRadius="6" Background="Transparent" BorderThickness="0"><TextBlock Text="Casual" FontSize="10" HorizontalAlignment="Center" Foreground="{StaticResource AppTextMutedBrush}" /></Button>
                                    <Button Grid.Row="1" Grid.Column="1" Click="OnSmartToneClicked" Tag="Decline" Padding="6" CornerRadius="6" Background="Transparent" BorderThickness="0"><TextBlock Text="Decline" FontSize="10" HorizontalAlignment="Center" Foreground="{StaticResource AppTextMutedBrush}" /></Button>
                                    <Button Grid.Row="1" Grid.Column="2" Click="OnSmartToneClicked" Tag="Propose Time" Padding="6" CornerRadius="6" Background="Transparent" BorderThickness="0"><TextBlock Text="Schedule" FontSize="10" HorizontalAlignment="Center" Foreground="{StaticResource AppTextMutedBrush}" /></Button>
                                </Grid>
                            </StackPanel>

                            <Border x:Name="CopilotHistoryContainer" Visibility="Collapsed">
                                <StackPanel Spacing="8">
                                    <Grid>
                                        <TextBlock x:Name="CopilotHistoryHeader" Text="Conversation" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource AppTextMutedBrush}" />
                                        <Button Click="OnResetCopilotHistory" Style="{StaticResource IconButtonStyle}" Width="22" Height="22" HorizontalAlignment="Right" ToolTipService.ToolTip="Clear conversation"><FontIcon Glyph="&#xE74D;" FontSize="9" /></Button>
                                    </Grid>
                                    <StackPanel x:Name="CopilotHistoryList" Spacing="8" />
                                </StackPanel>
                            </Border>

                            <StackPanel x:Name="DraftCard" Spacing="8" Visibility="Collapsed">
                                <Grid>
                                    <TextBlock x:Name="DraftToneHeader" Text="AI response" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource AppTextMutedBrush}" />
                                    <ProgressRing x:Name="DraftGeneratingRing" IsActive="False" Width="14" Height="14" HorizontalAlignment="Right" />
                                </Grid>
                                <TextBox x:Name="DraftContentBox" TextWrapping="Wrap" AcceptsReturn="True" FontSize="12" MinHeight="90" Background="Transparent" BorderThickness="0" Padding="0" />
                                <Grid>
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Button x:Name="InsertIntoChatBtn" Click="OnInsertDraftIntoChat" Background="{StaticResource AppAccentBrush}" CornerRadius="6" Padding="9,5"><StackPanel Orientation="Horizontal" Spacing="5"><FontIcon x:Name="InsertBtnIcon" Glyph="&#xE896;" FontSize="10" Foreground="White" /><TextBlock x:Name="InsertBtnText" Text="Insert" FontSize="10" FontWeight="SemiBold" Foreground="White" /></StackPanel></Button>
                                        <Button x:Name="CopyDraftBtn" Click="OnCopyDraft" Background="Transparent" BorderThickness="0" Padding="7,5"><StackPanel Orientation="Horizontal" Spacing="4"><FontIcon x:Name="CopyBtnIcon" Glyph="&#xE8C8;" FontSize="10" /><TextBlock x:Name="CopyBtnText" Text="Copy" FontSize="10" /></StackPanel></Button>
                                    </StackPanel>
                                    <Button Click="OnRegenerateDraft" Style="{StaticResource IconButtonStyle}" Width="26" Height="26" HorizontalAlignment="Right" ToolTipService.ToolTip="Regenerate"><FontIcon Glyph="&#xE72C;" FontSize="10" /></Button>
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <Border Grid.Row="4" Background="{StaticResource AppBorderBrush}" />
                    <Grid Grid.Row="5" Padding="12,9">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBox x:Name="CustomPromptBox" Grid.Column="0" PlaceholderText="Ask about this conversation…" KeyDown="OnCustomPromptKeyDown" FontSize="11.5" CornerRadius="8" Background="{StaticResource AppCardBrush}" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" Padding="10,6" />
                        <Button x:Name="SendCustomPromptBtn" Grid.Column="2" Click="OnSendCustomPrompt" Background="{StaticResource AppAccentBrush}" CornerRadius="15" Width="30" Height="30" Padding="0"><FontIcon Glyph="&#xE74A;" FontSize="11" Foreground="White" /></Button>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
