<UserControl
    x:Class="PINGGO.Views.LockScreenControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="#E61C1A1D">
        <Border Width="420" Background="{ThemeResource AppElevatedBrush}" BorderBrush="{ThemeResource AppBorderBrush}" BorderThickness="1" CornerRadius="20" Padding="40" VerticalAlignment="Center" HorizontalAlignment="Center">
            <StackPanel Spacing="24" HorizontalAlignment="Center">
                <!-- App Logo -->
                <Border Width="64" Height="64" CornerRadius="16" Background="{ThemeResource AppAccentBrush}" HorizontalAlignment="Center">
                    <FontIcon Glyph="&#xE72E;" FontSize="26" Foreground="#1C1A1D" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <StackPanel Spacing="4" HorizontalAlignment="Center">
                    <TextBlock Text="PINGGO Locked" FontSize="24" FontWeight="SemiBold" Foreground="{ThemeResource AppTextBrush}" HorizontalAlignment="Center" />
                    <TextBlock Text="Authenticate to access your workspaces" FontSize="14" Foreground="{ThemeResource AppTextMutedBrush}" HorizontalAlignment="Center" />
                </StackPanel>

                <!-- Windows Hello Button -->
                <Button Click="OnWindowsHelloClicked" HorizontalAlignment="Stretch" Style="{StaticResource PrimaryButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                        <FontIcon Glyph="&#xE72E;" FontSize="16" />
                        <TextBlock Text="Unlock with Windows Hello" FontSize="14" FontWeight="SemiBold" />
                    </StackPanel>
                </Button>

                <TextBlock Text="— OR ENTER PIN —" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AppTextMutedBrush}" HorizontalAlignment="Center" />

                <!-- PIN Input -->
                <StackPanel Spacing="10">
                    <PasswordBox x:Name="PinBox" PlaceholderText="Enter Security PIN" Background="{StaticResource AppCardBrush}" BorderBrush="{StaticResource AppBorderBrush}" CornerRadius="10" KeyDown="OnPinKeyDown" />
                    <Button Click="OnUnlockWithPinClicked" HorizontalAlignment="Stretch" Style="{StaticResource SecondaryButtonStyle}">
                        <TextBlock Text="Unlock" FontSize="14" FontWeight="SemiBold" />
                    </Button>
                </StackPanel>

                <TextBlock x:Name="ErrorText" Visibility="Collapsed" Text="Incorrect PIN. Please try again." FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AppErrorColor}" HorizontalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
