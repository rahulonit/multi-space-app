<UserControl
    x:Class="PINGGO.Views.InboxControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:PINGGO.Models">

    <ScrollViewer Background="{StaticResource AppBackgroundBrush}" Padding="32">
        <StackPanel Spacing="24" MaxWidth="900" HorizontalAlignment="Left">
            <!-- Header -->
            <StackPanel Spacing="4">
                <TextBlock Text="Consolidated Inbox &amp; AI Intelligence" FontSize="24" FontWeight="Bold" Foreground="White" />
                <TextBlock Text="Smart AI summaries, sentiment scoring, and 1-click stealth replies across all conversations" FontSize="13" Foreground="{StaticResource AppTextMutedBrush}" />
            </StackPanel>

            <!-- AI Daily Summary Card -->
            <Border Background="{StaticResource AppPanelBrush}" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20">
                <StackPanel Spacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Border Background="{StaticResource AppAccentBrush}" Width="24" Height="24" CornerRadius="6">
                            <FontIcon Glyph="&#xE76E;" FontSize="12" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="AI EXECUTIVE BRIEFING (STEALTH MODE)" FontSize="12" FontWeight="Bold" Foreground="{StaticResource AppAccentBrush}" VerticalAlignment="Center" />
                    </StackPanel>

                    <TextBlock x:Name="AiSummaryText" Text="All channels monitored. 0 critical escalations pending. High collaboration sentiment (+0.4) detected across product and engineering discussions. 3 quick approvals awaiting response."
                               FontSize="14" Foreground="White" TextWrapping="Wrap" LineHeight="22" />

                    <!-- Sentiment Badge -->
                    <Border Background="#1A22C55E" BorderBrush="#4D22C55E" BorderThickness="1" CornerRadius="12" Padding="10,4" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE73E;" FontSize="11" Foreground="{StaticResource AppSuccessBrush}" />
                            <TextBlock Text="Sentiment: Warm &amp; Highly Positive (+0.6)" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AppSuccessBrush}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- AI Smart Reply Generator Card -->
            <Border Background="{StaticResource AppPanelBrush}" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20">
                <StackPanel Spacing="14">
                    <StackPanel Spacing="4">
                        <TextBlock Text="AI SMART REPLIES (CONTEXT-AWARE)" FontSize="13" FontWeight="Bold" Foreground="White" />
                        <TextBlock Text="Select a reply draft to copy or inject into your active chat thread:" FontSize="12" Foreground="{StaticResource AppTextMutedBrush}" />
                    </StackPanel>

                    <ItemsRepeater x:Name="RepliesRepeater">
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="models:SmartReplyOption">
                                <Border Background="{StaticResource AppCardBrush}" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,4">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Tone Badge -->
                                        <Border Grid.Column="0" Background="#1A6366F1" BorderBrush="#4D6366F1" BorderThickness="1" CornerRadius="6" Padding="8,2" Margin="0,0,12,0" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind Tone}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AppAccentBrush}" />
                                        </Border>

                                        <!-- Draft Text -->
                                        <TextBlock Grid.Column="1" Text="{x:Bind Content}" FontSize="13" Foreground="White" TextWrapping="Wrap" VerticalAlignment="Center" />

                                        <!-- Copy Button -->
                                        <Button Grid.Column="2" Click="OnCopyReplyClicked" Tag="{x:Bind Content}" Style="{StaticResource IconButtonStyle}" Width="32" Height="32" Margin="10,0,0,0" ToolTipService.ToolTip="Copy reply to clipboard">
                                            <FontIcon Glyph="&#xE8C8;" FontSize="12" />
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
